# ========================================================
# VYUGAM AI HACKATHON - BACKEND API ENVIRONMENT TEMPLATE
# ========================================================
# Duplicate this file as .env in the backend folder and supply your values.

PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_for_hackathon_auth_sessions

# Supabase Credentials (Cloud PostgreSQL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
